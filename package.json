{
  "name": "boiscan",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "BoiScan — estimativa de peso bovino por fotografia (MVP local)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "experimental:train": "tsx scripts/experimental/train.ts",
    "experimental:demo": "tsx scripts/experimental/demo.ts",
    "experimental:images": "tsx scripts/experimental/real-images.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
