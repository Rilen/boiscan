{
  "packageId": "br.com.boiscan.app",
  "host": "<PUBLIC_HOST>",
  "name": "BoiScan",
  "launcherName": "BoiScan",
  "display": "standalone",
  "themeColor": "#1f4d38",
  "themeColorDark": "#0f1612",
  "navigationColor": "#f4f6f1",
  "navigationColorDark": "#0f1612",
  "navigationDividerColor": "#dbe3d7",
  "navigationDividerColorDark": "#2a3a2f",
  "backgroundColor": "#f4f6f1",
  "enableNotifications": false,
  "startUrl": "/",
  "iconUrl": "https://<PUBLIC_HOST>/icons/icon-512.png",
  "maskableIconUrl": "https://<PUBLIC_HOST>/icons/icon-512.png",
  "appVersion": "0.2.0",
  "appVersionCode": 1,
  "signingKey": {
    "path": "<ABSOLUTE_PATH_TO_UPLOAD_KEYSTORE>",
    "alias": "boiscan-upload"
  },
  "splashScreenFadeOutDuration": 300,
  "webManifestUrl": "https://<PUBLIC_HOST>/manifest.webmanifest",
  "fullScopeUrl": "https://<PUBLIC_HOST>/",
  "minSdkVersion": 23,
  "generatorApp": "bubblewrap-cli",
  "fingerprints": [],
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "orientation": "portrait",
  "fallbackType": "customtabs",
  "features": {}
}
